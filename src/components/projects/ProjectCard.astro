---
import type { Project } from '../../lib/projects';
import { formatDate } from '../../lib/projects';
import Tag from '../ui/Tag.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, tags, date, endDate, status } = project.data;
---

<article class="group relative w-full rounded-lg border border-border p-5 transition-colors hover:border-accent">
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="font-semibold">
      <a href={`/projects/${project.id}`} class="after:absolute after:inset-0">
        {title}
      </a>
    </h3>
    <span class="shrink-0 font-mono text-xs text-muted">
      {status === 'wip' ? 'In progress' : formatDate(endDate ?? date)}
    </span>
  </div>
  <p class="mt-2 text-sm text-muted">{summary}</p>
  {tags.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tech used">
      {tags.map((t) => (
        <li>
          <Tag label={t} />
        </li>
      ))}
    </ul>
  )}
</article>
