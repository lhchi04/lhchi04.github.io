---
// Theme is set before paint by the inline script in BaseLayout; this only toggles it.
---

<button
  id="theme-toggle"
  type="button"
  class="rounded-md p-2 text-muted transition-colors hover:text-fg"
  aria-label="Toggle dark mode"
>
  <svg
    class="hidden size-5 dark-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg
    class="size-5 light-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  :global([data-theme='dark']) .dark-icon {
    display: block;
  }
  :global([data-theme='dark']) .light-icon {
    display: none;
  }
</style>

<script>
  const button = document.getElementById('theme-toggle');
  button?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // storage unavailable — theme still applies for this page view
    }
  });
</script>
