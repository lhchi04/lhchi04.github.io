---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="This page doesn't exist.">
  <p class="font-mono text-sm text-muted">404</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
  <p class="mt-4 text-muted">The page you're looking for doesn't exist or was moved.</p>
  <p class="mt-8">
    <a href="/" class="text-accent hover:underline">
      ← Back home
    </a>
  </p>
</BaseLayout>
