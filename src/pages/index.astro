---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout>
  <main class="mx-auto max-w-3xl px-4 py-24">
    <h1 class="text-4xl font-bold tracking-tight">{site.name}</h1>
    <p class="mt-4 text-lg text-muted">{site.headline}</p>
    <p class="mt-8 text-sm text-muted">Site under construction — Phase 0.</p>
  </main>
</BaseLayout>
