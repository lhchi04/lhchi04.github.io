---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout title="Resume" description={`Resume of ${site.name}.`}>
  <h1 class="text-3xl font-bold tracking-tight">Resume</h1>
  {site.resumePdf ? (
    <p class="mt-6">
      <a href={site.resumePdf} class="text-accent hover:underline" download>
        Download PDF
      </a>
    </p>
  ) : (
    <p class="mt-6 text-muted">Resume coming soon.</p>
  )}
</BaseLayout>
