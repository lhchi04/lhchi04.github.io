---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillList from '../components/about/SkillList.astro';
import { site } from '../lib/site';
---

<BaseLayout title="About" description={`About ${site.name}: ${site.headline}`}>
  <h1 class="text-3xl font-bold tracking-tight">About</h1>
  <p class="mt-6 text-lg">{site.bio}</p>
  <p class="mt-4 text-muted">I grew up in Hanoi, Vietnam, and came to the US for college.</p>
  <p class="mt-4 text-muted">
    The best way to see how I work is my{' '}
    <a href="/projects" class="text-accent hover:underline">
      projects
    </a>
    , or reach me by{' '}
    <a href={`mailto:${site.email}`} class="text-accent hover:underline">
      email
    </a>
    .
  </p>

  <section class="mt-16" aria-labelledby="skills-heading">
    <h2 id="skills-heading" class="text-xl font-semibold">
      Tools I use
    </h2>
    <div class="mt-6">
      <SkillList />
    </div>
  </section>
</BaseLayout>
